<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiago_whole_body_controller</name>
  <version>0.2.0</version>
  <description>Zero-allocation C++ 17-DOF Dual-Arm QP Whole-Body Controller with TF2 and Robotiq grasping for PAL TIAGo</description>
  <maintainer email="mitsav01@users.noreply.github.com">Mitesh Savsaviya</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pinocchio</depend>
  <depend>Eigen3</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>