<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="apartment_world">

    <!-- Simulation Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::v8::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::v8::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::v8::systems::SceneBroadcaster"/>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- YOUR APARTMENT MODEL DEFINITION                                    -->
    <!-- =================================================================== -->
    <model name="apartment">
      <static>true</static>
      <joint name="world_apartment_joint" type="fixed">
        <pose relative_to="__model__">0 0 0 0 0 0</pose>
        <parent>world</parent>
        <child>apartment_root</child>
      </joint>

      <link name="apartment_root">
        <pose relative_to="world_apartment_joint">0 0 0 0 0 0</pose>
        <inertial>
          <pose>4.06791 0.80533 0.05117 0 0 0</pose>
          <mass>766</mass>
          <inertia>
            <ixx>1430.99</ixx><ixy>-4711.26</ixy><ixz>-224.39</ixz>
            <iyy>30901.0</iyy><iyz>-84.90</iyz><izz>32126.6</izz>
          </inertia>
        </inertial>

        <!-- Collisions -->
        <collision name="armchair_collision">
          <pose>16.8188 1.3709 0.4 0 0 1.9199</pose>
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
        </collision>
        <collision name="coffee_table_collision">
          <pose>16.6534 2.77957 0.2 0 0 1.5708</pose>
          <geometry><box><size>0.7 1.2 0.4</size></box></geometry>
        </collision>
        <collision name="sofa_collision">
          <pose>17.0486 4.1596 0.4 0 0 0</pose>
          <geometry><box><size>0.9 2.0 0.8</size></box></geometry>
        </collision>
        <collision name="wall1_collision">
          <pose>9.45 0.135 1.53 1.57 1.5708 0</pose>
          <geometry><box><size>3.05 18.95 0.003</size></box></geometry>
        </collision>
        <collision name="wall2_collision">
          <pose>-0.005 2.532 1.53 -3.14 1.5708 0</pose>
          <geometry><box><size>3.05 4.808 0.003</size></box></geometry>
        </collision>
        <collision name="wall3_collision">
          <pose>9.45 4.93 1.53 -1.57 1.5708 0</pose>
          <geometry><box><size>3.05 18.95 0.003</size></box></geometry>
        </collision>
        <collision name="wall4_collision">
          <pose>18.919 2.532 1.53 0 1.5708 0</pose>
          <geometry><box><size>3.05 4.808 0.003</size></box></geometry>
        </collision>
        <collision name="wardrobe_collision">
          <pose>18.4777 1.1169 0.975 0 0 0</pose>
          <geometry><box><size>0.487 1.0 1.65</size></box></geometry>
        </collision>
        <collision name="table_main_collision">
          <pose>5 4 0.3619 0 0 1.57</pose>
          <geometry><box><size>1.2 1.8 0.72</size></box></geometry>
        </collision>

        <!-- Visuals -->
        <visual name="armchair_visual">
          <pose>16.8188 1.3709 0 0 0 1.9199</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/armchair.dae</uri></mesh></geometry>
        </visual>
        <visual name="coffee_table_visual">
          <pose>16.6534 2.77957 0 0 0 1.5708</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/coffee_table.dae</uri></mesh></geometry>
        </visual>
        <visual name="sofa_visual">
          <pose>17.0486 4.1596 0 0 0 0</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/sofa.dae</uri></mesh></geometry>
        </visual>
        <visual name="walls_visual">
          <pose>8.85 1.75 -0.2 0 0 0</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/walls.dae</uri></mesh></geometry>
        </visual>
        <visual name="wardrobe_visual">
          <pose>18.5582 1.1169 0 0 0 0</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/wardrobe.dae</uri></mesh></geometry>
        </visual>
        <visual name="windows_visual">
          <pose>8.85 1.75 -0.2 0 0 0</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/windows.dae</uri></mesh></geometry>
        </visual>
        <visual name="table_main_visual">
          <pose>5 4 0.3619 0 0 1.57</pose>
          <geometry><mesh><uri>package://iai_apartment/meshes/misc/big_table_1.dae</uri></mesh></geometry>
        </visual>
      </link>

      <!-- Movable Joints / Links -->
      <joint name="coffee_table_drawer_joint" type="prismatic">
        <pose relative_to="apartment_root">16.6534 2.77957 0 0 0 1.5708</pose>
        <parent>apartment_root</parent>
        <child>coffee_table_drawer</child>
        <axis>
          <xyz>-1 0 0</xyz>
          <limit><lower>0</lower><upper>0.5</upper><effort>100</effort><velocity>0.5</velocity></limit>
        </axis>
      </joint>

      <link name="coffee_table_drawer">
        <pose relative_to="coffee_table_drawer_joint">0 0 0 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
        </inertial>
        <visual name="coffee_table_drawer_visual">
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/coffee_table_drawer.dae</uri></mesh></geometry>
        </visual>
      </link>

      <joint name="wardrobe_door_left_joint" type="revolute">
        <pose relative_to="apartment_root">18.2336 1.6169 0 0 0 0</pose>
        <parent>apartment_root</parent>
        <child>wardrobe_door_left</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit><lower>0</lower><upper>1.5708</upper><effort>100</effort><velocity>1.5708</velocity></limit>
        </axis>
      </joint>

      <link name="wardrobe_door_left">
        <pose relative_to="wardrobe_door_left_joint">0 0 0 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
        </inertial>
        <collision name="wardrobe_door_left_collision">
          <pose>-0.0064 -0.2485 0.975 0 0 0</pose>
          <geometry><box><size>0.013 0.495 1.648</size></box></geometry>
        </collision>
        <visual name="wardrobe_door_left_visual">
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/wardrobe_door_left.dae</uri></mesh></geometry>
        </visual>
      </link>

      <joint name="wardrobe_door_right_joint" type="revolute">
        <pose relative_to="apartment_root">18.2336 0.6169 0 0 0 0</pose>
        <parent>apartment_root</parent>
        <child>wardrobe_door_right</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0</lower><upper>1.5708</upper><effort>100</effort><velocity>1.5708</velocity></limit>
        </axis>
      </joint>

      <link name="wardrobe_door_right">
        <pose relative_to="wardrobe_door_right_joint">0 0 0 0 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
        </inertial>
        <collision name="wardrobe_door_right_collision">
          <pose>-0.0064 0.2485 0.975 0 0 0</pose>
          <geometry><box><size>0.013 0.495 1.648</size></box></geometry>
        </collision>
        <visual name="wardrobe_door_right_visual">
          <geometry><mesh><uri>package://iai_apartment/meshes/visual/wardrobe_door_right.dae</uri></mesh></geometry>
        </visual>
      </link>

    </model>

  </world>
</sdf>